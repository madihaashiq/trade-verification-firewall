      "parameters": {
        "jsCode": "const raw = $input.first().json.candidates[0].content.parts[0].text;\nconst cleaned = raw.replace(/```json|```/g, '').trim();\nconst parsed = JSON.parse(cleaned);\n\n// Safety net: verify the symbol actually exists in the real contract list\nif (parsed.action === 'TRADE') {\n  const validContracts = $json.option_contracts.map(c => c.symbol);\n  if (!validContracts.includes(parsed.symbol)) {\n    return [{\n      json: {\n        ...parsed,\n        action: 'HOLD',\n        symbol: null,\n        side: null,\n        qty: null,\n        order_type: null,\n        reasoning: `Safety override: Gemini proposed symbol \"${parsed.symbol}\" which does not exist in the fetched contract list. Defaulting to HOLD.`\n      }\n    }];\n  }\n}\n\nreturn [{ json: parsed }];"
      },
